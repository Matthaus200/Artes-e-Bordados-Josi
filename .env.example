# Configuração do Firebase — copie este arquivo para .env e preencha.
#
# Onde achar os valores:
#   console.firebase.google.com > seu projeto
#   > Configurações do projeto > Seus apps > app web
#   > bloco "firebaseConfig"
#
# Estes valores NÃO são segredo: a config web do Firebase vai no bundle
# publicado por design. Ela identifica o projeto, não autoriza nada — quem
# protege os dados são as regras em firestore.rules somadas ao Auth.
# O .env fica fora do Git mesmo assim, porque aponta para qual projeto este
# ambiente usa, e isso muda entre o seu local e a produção.
#
# Na Vercel: Settings > Environment Variables, os mesmos nomes e valores.
# Depois de cadastrar lá, é preciso um novo deploy para que passem a valer.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
